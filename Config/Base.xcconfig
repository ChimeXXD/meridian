DISPLAY_NAME = Meridian
BUNDLE_PREFIX = dev.chime
APP_GROUP_ID = group.$(BUNDLE_PREFIX).meridian
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
