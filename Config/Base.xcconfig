// Shared build settings for every target.
// To build on your own device, copy Signing.local.xcconfig.example to
// Signing.local.xcconfig (git-ignored) and set your team and bundle prefix there.

DISPLAY_NAME = Meridian
BUNDLE_PREFIX = dev.chime
APP_GROUP_ID = group.$(BUNDLE_PREFIX).meridian
// "Report a wrong time" recipient while the repo is private (D-34). Set it in the git-ignored Signing.local.xcconfig;
// empty here, so the address is never committed and the email opens with no recipient.
REPORT_EMAIL =
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
